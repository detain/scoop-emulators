    "url": "https://downloads.sourceforge.net/project/nanowasp/nanowasp/2.0b/nanowasp-2.0b.exe#/dl.7z",
    "hash": "sha1:9f7cbedd4d1790807eb508f480255ae544d4d5e7",
    "pre_install": "Remove-Item \"$dir\\`$*\", \"$dir\\uninstall*\" -Recurse -Force -ErrorAction SilentlyContinue",
