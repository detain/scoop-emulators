        "cmd:%BIN% %ROM%",
        "logo:https://consolo.is.cc/images/emuDownloadCenter/hooks/nanowasp/emulator_logo.png",
        "screenshot:https://consolo.is.cc/images/emuDownloadCenter/hooks/nanowasp/emulator_screen_01.jpg"
    ],
    "version": "2.0b",
    "description": "Microbee emulator",
    "homepage": "https://sourceforge.net/projects/nanowasp/",
