    "shortcuts": [
        [
            "nanowasp.exe",
            "NanoWasp"
        ]
    ],
    "persist": "Data",
    "checkver": {
        "url": "https://sourceforge.net/projects/nanowasp/rss?path=/nanowasp",
        "regex": "nanowasp/([\\d.]+[a-z]?)/nanowasp-[\\d.]+[a-z]?\\.exe"
    },
    "autoupdate": {
        "url": "https://downloads.sourceforge.net/project/nanowasp/nanowasp/$version/nanowasp-$version.exe#/dl.7z"
    }
