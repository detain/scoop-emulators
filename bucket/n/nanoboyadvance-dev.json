        "regex": "^(?<version>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<hash>[\\da-f]{7})",
        "replace": "${version}-${year}${month}${day}-${hash}"
