{
    "##": [
        "name:TilEm",
        "author:Benjamin Moody and Thibault Duponchelle",
        "cmd:%BIN% %ROM%",
        "logo:https://consolo.is.cc/images/emuDownloadCenter/hooks/tilem/emulator_logo.png",
        "screenshot:https://consolo.is.cc/images/emuDownloadCenter/hooks/tilem/emulator_screen_01.jpg"
    ],
    "version": "2.0",
    "description": "Texas Instruments Z80-based graphing calculator emulator and debugger",
    "homepage": "http://lpg.ticalc.org/prj_tilem/",
    "license": "GPL-3.0-or-later",
    "notes": "TilEm needs a ROM image dumped from your own calculator.",
    "url": "https://downloads.sourceforge.net/project/tilem/tilem/2.0/tilem-2.0-win32.zip",
    "hash": "sha1:ce7e499cff1fc28e207a083f3ff1e10554136ea4",
    "pre_install": [
        "Expand-7zipArchive \"$dir\\tilem-$version.exe\" \"$dir\" -Removal",
        "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "bin": [
        [
            "tilem2.exe",
            "tilem"
        ]
    ],
    "shortcuts": [
        [
            "tilem2.exe",
            "TilEm"
        ]
    ],
    "checkver": {
        "url": "https://sourceforge.net/projects/tilem/rss",
        "regex": "tilem/([\\d.]+)/tilem-[\\d.]+-win32\\.zip"
    },
    "autoupdate": {
        "url": "https://downloads.sourceforge.net/project/tilem/tilem/$version/tilem-$version-win32.zip"
    }
}
