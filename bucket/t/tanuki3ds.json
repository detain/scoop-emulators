    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\ctremu.ini\")) {",
        "    New-Item \"$dir\\ctremu.ini\" -Type File | Out-Null",
        "}",
        "if (!(Test-Path \"$persist_dir\\portable.txt\")) {",
        "    New-Item \"$dir\\portable.txt\" -Type File | Out-Null",
        "}"
    ],
    "bin": [
        [
            "ctremu.exe",
            "tanuki3ds"
        ]
    ],
    "shortcuts": [
        [
            "ctremu.exe",
            "Tanuki3DS"
        ]
    ],
    "persist": [
        "3ds",
        "ctremu.ini",
        "portable.txt"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/burhanr13/Tanuki3DS/releases/download/v$version/Tanuki3DS-windows.zip"
            }
        }
    }
