    "installer": {
        "script": [
            "$out = [IO.File]::Create(\"$dir\\dcmo5.exe\")",
            "Get-ChildItem \"$dir\\*.dat\" | Sort-Object Name | ForEach-Object {",
            "    $bytes = [IO.File]::ReadAllBytes($_.FullName)",
            "    $out.Write($bytes, 0, $bytes.Length)",
            "}",
            "$out.Close()",
            "Remove-Item \"$dir\\*.dat\", \"$dir\\install.bat\""
        ]
    },
    "bin": "dcmo5.exe",
    "shortcuts": [
        [
            "dcmo5.exe",
            "DCMO5"
        ]
    ],
    "checkver": {
        "url": "https://dcmoto.pages-perso.free.fr/emulateur/index.html",
        "regex": "prog/dcmo5_(?<y>\\d{4})(?<m>\\d{2})(?<d>\\d{2})\\.zip",
        "replace": "${y}.${m}.${d}"
    },
    "autoupdate": {
        "url": "https://dcmoto.pages-perso.free.fr/emulateur/prog/dcmo5_$cleanVersion.zip"
    }
