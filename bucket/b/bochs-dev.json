    "checkver": {
        "github": "https://api.github.com/repos/bochs-emu/Bochs/actions/workflows/win-cross.yml/runs?branch=master&event=push&status=success",
        "script": [
            "$sha = json_path $page '$.workflow_runs[0].head_sha'",
            "$runNumber = json_path $page '$.workflow_runs[0].run_number'",
            "$runId = json_path $page '$.workflow_runs[0].id'",
            "$date = json_path $page '$.workflow_runs[0].created_at'",
            "Write-Output \"$runNumber $date $sha $runId\""
        ],
        "regex": "^(?<build>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<sha>[0-9a-f]{7})[0-9a-f]* (?<run>\\d+)$",
        "replace": "${build}-${year}${month}${day}-${sha}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": [
                    "https://github.com/bochs-emu/Bochs/releases/download/REL_3_1_FINAL/Bochs-win64-3.1.exe#/dl.7z",
                    "https://nightly.link/bochs-emu/Bochs/actions/runs/$matchRun/bochs-$matchSha.exe.zip",
                    "https://nightly.link/bochs-emu/Bochs/actions/runs/$matchRun/tools-$matchSha.zip"
                ]
            }
        }
    }
