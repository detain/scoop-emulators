{
    "version": "2026-11-25",
    "description": "Frontend for emulators, game engines and media players (nightly)",
    "homepage": "https://www.retroarch.com/",
    "license": "GPL-3.0-only",
    "notes": [
        "ATTENTION: Retroarch requires BIOS/firmware files for some emulation.",
        "It is recommended to read the libretro docs for each core you plan to use.",
        "See https://docs.libretro.com/library/bios/ for more information."
    ],
    "architecture": {
        "32bit": {
            "url": "https://buildbot.libretro.com/nightly/windows/x86/2026-11-25_RetroArch.7z",
            "hash": "0c9c0292bb9728572ee5c3e9d0027cd55ef51dd82adb3d9d02d51dc250096ede",
            "extract_dir": "RetroArch-Win32"
        },
        "64bit": {
            "url": "https://buildbot.libretro.com/nightly/windows/x86_64/2026-11-25_RetroArch.7z",
            "hash": "8ad2225d93ca4e6f48f3e2e8dec5d64c8a9b91a0ee42ce5b4c5ea07f41feb00d",
            "extract_dir": "RetroArch-Win64"
        }
    },
    "pre_install": [
        "# Clean up empty folders left behind by older versions of this manifest (they break RetroArch's config loading)",
        "'retroarch.cfg', 'content_favorites.lpl', 'content_history.lpl' | ForEach-Object {",
        "    if ((Test-Path \"$persist_dir\\$_\" -PathType Container) -and !(Get-ChildItem \"$persist_dir\\$_\" -Force)) { Remove-Item \"$persist_dir\\$_\" -Force }",
        "}",
        "if (!(Test-Path \"$persist_dir\\retroarch.cfg\")) { Copy-Item \"$dir\\retroarch.default.cfg\" \"$dir\\retroarch.cfg\" }",
        "'favorites', 'history' | ForEach-Object {",
        "    if (!(Test-Path \"$persist_dir\\content_$_.lpl\")) { New-Item \"$dir\\content_$_.lpl\" -ItemType File | Out-Null }",
        "}"
    ],
    "bin": [
        [
            "retroarch.exe",
            "retroarch-dev"
        ]
    ],
    "shortcuts": [
        [
            "retroarch.exe",
            "RetroArch (dev)"
        ]
    ],
    "persist": [
        "assets\\wallpapers",
        "config",
        "cores",
        "cheats",
        "overlays",
        "playlists",
        "records",
        "recordings",
        "saves",
        "screenshots",
        "shaders\\presets",
        "states",
        "system",
        "thumbnails",
        "content_favorites.lpl",
        "content_history.lpl",
        "retroarch.cfg"
    ],
    "checkver": {
        "url": "https://buildbot.libretro.com/nightly/windows/x86_64/",
        "regex": "(?smi)(\\d{4}-\\d{2}-\\d{2})_RetroArch\\.7z",
        "reverse": true
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://buildbot.libretro.com/nightly/windows/x86/$version_RetroArch.7z"
            },
            "64bit": {
                "url": "https://buildbot.libretro.com/nightly/windows/x86_64/$version_RetroArch.7z"
            }
        }
    }
}
