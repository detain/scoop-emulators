    "url": "https://github.com/Hydr8gon/rokuyon/releases/download/release/rokuyon-windows.zip",
    "hash": "3afedb4a94b6e982edb23dacfde38d28d3865b90784aeb95cb1c5b72763db9f7",
    "bin": "rokuyon.exe",
    "shortcuts": [
        [
            "rokuyon.exe",
            "rokuyon"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Hydr8gon/rokuyon/actions/workflows/autobuild.yml/runs?branch=main&status=success&event=push",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<run>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<commit>[\\da-f]{7})",
        "replace": "${run}-${year}${month}${day}-${commit}"
    },
    "autoupdate": {
        "url": "https://github.com/Hydr8gon/rokuyon/releases/download/release/rokuyon-windows.zip"
    }
}
