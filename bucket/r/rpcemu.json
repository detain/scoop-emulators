    "hash": "bc57d19713b90baf9d9f8be51dec2b9ab158ec74eedc3fc0a84b6d3fd8510329",
    "extract_dir": "RPCEmu",
    "bin": [
        [
            "RPCEmu-Recompiler.exe",
            "rpcemu"
        ],
        [
            "RPCEmu-Interpreter.exe",
            "rpcemu-interpreter"
        ]
    ],
    "shortcuts": [
        [
            "RPCEmu-Recompiler.exe",
            "RPCEmu"
        ],
        [
            "RPCEmu-Interpreter.exe",
            "RPCEmu (Interpreter)"
        ]
    ],
