            "xm7"
        ]
    ],
    "shortcuts": [
        [
            "XM7.exe",
            "XM7"
        ]
    ],
    "persist": "XM7.ini",
    "checkver": {
        "url": "http://retropc.net/pi/xm7/index.html",
        "regex": "xm7dash_(r\\d+)\\.zip"
    },
    "autoupdate": {
        "url": "http://retropc.net/pi/xm7/xm7dash_$version.zip"
    }
