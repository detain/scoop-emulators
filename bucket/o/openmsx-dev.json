        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\\openmsx-*-bin.zip\" | ForEach-Object {",
        "    Expand-7zipArchive -Path $_.FullName -DestinationPath \"$dir\" -Removal",
        "}"
    ],
    "bin": [
        [
            "openmsx.exe",
            "openmsx-dev"
        ]
    ],
    "shortcuts": [
