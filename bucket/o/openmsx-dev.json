            "openMSX (dev)"
        ]
    ],
    "checkver": {
        "url": "https://nightly.link/openMSX/openMSX/workflows/build_snapshots/master",
        "regex": "master/openmsx-(?<version>[\\d.]+-\\d+-g[0-9a-f]+)-windows-vc-x64-bin\\.zip\""
    },
    "autoupdate": {
        "architecture": {
