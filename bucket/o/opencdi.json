    "bin": "opencdi.exe",
    "shortcuts": [
        [
            "opencdi.exe",
            "OpenCDi"
        ]
    ],
    "persist": [
        "bios",
        "opencdi_controls.ini",
        "opencdi_recent.txt"
    ],
    "checkver": "github",
