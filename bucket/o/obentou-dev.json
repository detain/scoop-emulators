    "bin": [
        [
            "obentou.exe",
            "obentou-dev"
        ]
    ],
    "shortcuts": [
        [
            "obentou.exe",
            "Obentou (dev)"
        ]
    ],
    "persist": "config.ini",
    "checkver": {
        "github": "https://api.github.com/repos/yughias/Obentou/actions/workflows/build.yaml/runs?branch=main&event=push&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<version>[^ ]+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})[^ ]+ (?<hash>.{7})(?<rest>.*)$",
        "replace": "${version}-${year}${month}${day}-${hash}"
    },
    "autoupdate": {
        "url": "https://nightly.link/yughias/Obentou/workflows/build.yaml/main/obentou-windows.zip"
    }
}
