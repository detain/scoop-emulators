{
    "##": [
        "name:Medusa",
        "author:Jeffrey Pfau",
        "cmd:%BIN% %ROM%",
        "logo:https://consolo.is.cc/images/emuDownloadCenter/hooks/medusa/emulator_logo.png",
        "screenshot:https://consolo.is.cc/images/emuDownloadCenter/hooks/medusa/emulator_screen_01.jpg"
    ],
    "version": "a2",
    "description": "Nintendo DS, Game Boy Advance and Game Boy emulator, an experimental fork of mGBA",
    "homepage": "https://mgba.io/tag/medusa/",
    "license": "MPL-2.0",
    "url": "https://github.com/mgba-emu/mgba/releases/download/medusa-a2/medusa-a2-win64.7z",
    "hash": "8afb9f8a7c9f6e0bfb65f350a13880c38526cdbb53e74660efda0e49d8035a5c",
    "extract_dir": "medusa-medusa-2017-04-26-win64",
    "pre_install": [
        "'portable.ini', 'config.ini', 'qt.ini' | ForEach-Object {",
        "    if (!(Test-Path \"$persist_dir\\$_\")) {",
        "        New-Item \"$dir\\$_\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": "medusa.exe",
    "shortcuts": [
        [
            "medusa.exe",
            "medusa"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "qt.ini"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/mgba-emu/mgba/releases?per_page=100",
        "script": "Write-Output $page",
        "regex": "\"tag_name\":\\s*\"medusa-(?<version>a\\d+)\"[\\s\\S]*?\"published_at\":\\s*\"(?<date>\\d{4}-\\d{2}-\\d{2})",
        "replace": "${version}"
    },
    "autoupdate": {
        "url": "https://github.com/mgba-emu/mgba/releases/download/medusa-$version/medusa-$version-win64.7z",
        "extract_dir": "medusa-medusa-$matchDate-win64"
    }
}
