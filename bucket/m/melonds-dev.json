{
    "version": "3560-20261118-361ffa9",
    "description": "Nintendo DS emulator (development version)",
    "homepage": "https://melonds.kuribo64.net/",
    "license": "GPL-3.0-only",
    "notes": [
        "ATTENTION: MelonDS requires BIOS and firmware files dumped from a Nintendo DS to function.",
        "Builds are GitHub Actions artifacts (via nightly.link) and expire after 90 days."
    ],
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/melonDS-emu/melonDS/actions/runs/44354887244/melonDS-windows-x86_64.zip",
            "hash": "755055bd144601fda61abd72f460d89b45f9841601041fdba49731073c8c48fb"
        },
        "arm64": {
            "url": "https://nightly.link/melonDS-emu/melonDS/actions/runs/44354887244/melonDS-windows-arm64.zip",
            "hash": "f143a5496fbfdf99cb611ccba9e0927070487c0c7ac07845b2bf9c98cf4b3788"
        }
    },
    "installer": {
        "script": [
            "$FILE = 'melonDS.ini'",
            "if (!(Test-Path \"$persist_dir\\$FILE\")) {",
            "    New-Item \"$dir\\$FILE\" -Type File | Out-Null",
            "}"
        ]
    },
    "bin": [
        [
            "melonDS.exe",
            "melonds-dev"
        ]
    ],
    "shortcuts": [
        [
            "melonDS.exe",
            "melonDS (dev)"
        ]
    ],
    "persist": "melonDS.ini",
    "checkver": {
        "github": "https://api.github.com/repos/melonDS-emu/melonDS/actions/workflows/build-windows.yml/runs?event=push&branch=master&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "$id = json_path $page $.workflow_runs[0].id",
            "Write-Output \"$runId $date $id $sha\""
        ],
        "regex": "^(?<run>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<runid>\\d+) (?<commit>[\\da-f]{7})",
        "replace": "${run}-${year}${month}${day}-${commit}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/melonDS-emu/melonDS/actions/runs/$matchRunid/melonDS-windows-x86_64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/melonDS-emu/melonDS/actions/runs/$matchRunid/artifacts",
                    "regex": "\"name\":\\s*\"melonDS-windows-x86_64\"[\\s\\S]*?\"digest\":\\s*\"sha256:$sha256\""
                }
            },
            "arm64": {
                "url": "https://nightly.link/melonDS-emu/melonDS/actions/runs/$matchRunid/melonDS-windows-arm64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/melonDS-emu/melonDS/actions/runs/$matchRunid/artifacts",
                    "regex": "\"name\":\\s*\"melonDS-windows-arm64\"[\\s\\S]*?\"digest\":\\s*\"sha256:$sha256\""
                }
            }
        }
    }
}
