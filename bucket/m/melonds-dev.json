{
    "version": "3468-20260729-b3dd988",
    "description": "Nintendo DS emulator",
    "homepage": "https://melonds.kuribo64.net/",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/melonDS-emu/melonDS/actions/runs/30483829067/melonDS-windows-x86_64.zip",
            "hash": "6a48ada6026d816fd8d40d68e83d7fdc161a642e32f18fed5ff5ef9380b787d0"
        },
        "arm64": {
            "url": "https://nightly.link/melonDS-emu/melonDS/actions/runs/30483829067/melonDS-windows-arm64.zip",
            "hash": "8867480d867f08a6f30af84474cb1eef89056aa68a535a8be2aab4daf5a33bb7"
        }
    },
    "installer": {
        "script": [
            "$FILE = 'melonDS.ini'",
            "if (!(Test-Path \"$persist_dir\\$FILE\")) {",
            "    New-Item \"$dir\\$FILE\" -Type File | Out-Null",
            "}"
        ]
    },
    "bin": "melonDS.exe",
    "shortcuts": [
        [
            "melonDS.exe",
            "melonDS (dev)"
        ]
    ],
    "persist": "melonDS.ini",
    "checkver": {
        "url": "https://api.github.com/repos/melonDS-emu/melonDS/actions/workflows/build-windows.yml/runs?event=push&branch=master&status=success&per_page=1",
        "script": [
            "$run = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "$runId = json_path $page $.workflow_runs[0].id",
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "Write-Output \"$run $date $runId $sha\""
        ],
        "regex": "^(?<run>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<runid>\\d+) (?<commit>[\\da-f]{7})[\\da-f]+$",
        "replace": "${run}-${year}${month}${day}-${commit}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/melonDS-emu/melonDS/actions/runs/$matchRunid/melonDS-windows-x86_64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/melonDS-emu/melonDS/actions/runs/$matchRunid/artifacts",
                    "regex": "\"name\":\\s*\"melonDS-windows-x86_64\"[\\s\\S]*?\"digest\":\\s*\"sha256:$sha256\""
                }
            },
            "arm64": {
                "url": "https://nightly.link/melonDS-emu/melonDS/actions/runs/$matchRunid/melonDS-windows-arm64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/melonDS-emu/melonDS/actions/runs/$matchRunid/artifacts",
                    "regex": "\"name\":\\s*\"melonDS-windows-arm64\"[\\s\\S]*?\"digest\":\\s*\"sha256:$sha256\""
                }
            }
        }
    }
}
