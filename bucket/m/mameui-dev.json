{
    "version": "850-20261113-9d965d4",
    "description": "Arcade machine emulator (MAME) with an integrated Windows GUI front-end (development version)",
    "homepage": "https://messui.1emulation.com/",
    "license": "GPL-2.0-or-later",
    "notes": [
        "Development builds come from GitHub Actions artifacts of Robbbert/mameui (via nightly.link), which expire about 14 days after the build.",
        "The artifact contains only mameui.exe (no plugins, language, hash or artwork files)."
    ],
    "url": "https://nightly.link/Robbbert/mameui/actions/runs/43522825290/mameui-windows-gcc-9d965d45e85ac7baeed04fc19eea9b040ad68e20.zip",
    "hash": "0e854c0fa52ac82df36a449acb3463674f44ca14665317ccf2e43e7f0ebcb3ee",
    "bin": [
        [
            "mameui.exe",
            "mameui-dev"
        ]
    ],
    "shortcuts": [
        [
            "mameui.exe",
            "MAMEUI (dev)"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Robbbert/mameui/actions/workflows/ci-mameui.yml/runs?branch=master&event=push&status=success&per_page=1",
        "script": [
            "$run = json_path $page $.workflow_runs[0].run_number",
            "$id = json_path $page $.workflow_runs[0].id",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "Write-Output \"$run $id $date $sha\""
        ],
        "regex": "^(?<run>\\d+) (?<id>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<short>[0-9a-f]{7})(?<rest>[0-9a-f]+)$",
        "replace": "${run}-${year}${month}${day}-${short}"
    },
    "autoupdate": {
        "url": "https://nightly.link/Robbbert/mameui/actions/runs/$matchId/mameui-windows-gcc-$matchShort$matchRest.zip"
    }
}
