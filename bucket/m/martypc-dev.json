{
    "version": "158-20260907-05c0d08",
    "description": "Cycle-accurate IBM PC/XT, PCjr and Tandy 1000 emulator written in Rust (development version)",
    "homepage": "https://github.com/dbalsom/martypc",
    "license": "MIT",
    "notes": [
        "GLaBIOS is bundled; original IBM ROMs can be placed in $dir\\media\\roms.",
        "Development builds come from GitHub Actions artifacts (via nightly.link), which expire about 90 days after the last successful build."
    ],
    "url": "https://nightly.link/dbalsom/martypc/workflows/windows/main/martypc-windows-gha.zip",
    "hash": "a729c9c3e65b113fdf80b1916b49bd614a8e04f1f1c34744e9e135f99fb029c1",
    "bin": [
        [
            "martypc.exe",
            "martypc-dev"
        ],
        [
            "martypc_launcher.exe",
            "martypc-launcher-dev"
        ]
    ],
    "shortcuts": [
        [
            "martypc_launcher.exe",
            "MartyPC (dev)"
        ]
    ],
    "persist": "martypc.toml",
    "checkver": {
        "github": "https://api.github.com/repos/dbalsom/martypc/actions/workflows/windows.yml/runs?branch=main&event=push&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<version>[^ ]+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})[^ ]+ (?<hash>.{7})(?<rest>.*)$",
        "replace": "${version}-${year}${month}${day}-${hash}"
    },
    "autoupdate": {
        "url": "https://nightly.link/dbalsom/martypc/workflows/windows/main/martypc-windows-gha.zip"
    }
}
