        "cmd:%BIN% %ROM%",
        "screenshot:https://consolo.is.cc/images/emuDownloadCenter/hooks/mahnes/emulator_screen_01.jpg"
    ],
    "version": "20151027",
    "description": "Nintendo Entertainment System emulator with 6502 sub-instruction timing",
    "homepage": "https://github.com/hlorenzi/mahnes",
    "license": "Freeware",
    "notes": "MahNES has no versioned releases; this package is the Windows binary committed to the official repository (version = commit date).",
    "url": "https://raw.githubusercontent.com/hlorenzi/mahnes/fe77adce502c85c0716673194741d935a66673f7/bin/win32_release/mahnes.exe",
    "hash": "8c781af60e614167255920475f7b59b175ba7fa385f50845d503f337128dc6bd",
    "bin": "mahnes.exe",
    "shortcuts": [
        [
            "mahnes.exe",
            "MahNES"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/hlorenzi/mahnes/commits?path=bin/win32_release/mahnes.exe&per_page=1",
        "script": "Write-Output $page",
        "regex": "\"sha\":\\s*\"(?<sha>[0-9a-f]{40})\"[\\s\\S]*?\"committer\":\\s*\\{[^}]*?\"date\":\\s*\"(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})",
        "replace": "${year}${month}${day}"
    },
    "autoupdate": {
        "url": "https://raw.githubusercontent.com/hlorenzi/mahnes/$matchSha/bin/win32_release/mahnes.exe"
    }
}
