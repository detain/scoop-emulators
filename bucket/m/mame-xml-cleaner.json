    "checkver": {
        "script": [
            "$req = [System.Net.WebRequest]::Create('https://www.systempixel.fr/download/mxc-last.php')",
            "$req.AllowAutoRedirect = $false",
            "$req.UserAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)'",
            "$resp = $req.GetResponse()",
            "Write-Output $resp.Headers['Location']",
            "$resp.Close()"
        ],
        "regex": "mxc(?<year>\\d{4})_(?<major>\\d)(?<minor>\\d+)\\.exe",
        "replace": "${year}.${major}.${minor}"
    },
    "autoupdate": {
        "url": "https://www.systempixel.fr/download/mxc$matchYear_$matchMajor$matchMinor.exe#/dl.7z"
    }
