{
    "version": "191-20261112-5d220f0",
    "description": "Multi-system computer and console emulator (MAME/MESS) with the MESSUI Windows interface (development version)",
    "homepage": "http://messui.1emulation.com/",
    "license": "GPL-2.0-or-later",
    "notes": [
        "Development builds come from GitHub Actions artifacts of Robbbert/messui (via nightly.link), which expire about 9 days after the build.",
        "The artifact contains only messui.exe (no plugins, language, hash or artwork files)."
    ],
    "url": "https://nightly.link/Robbbert/messui/actions/runs/43148213932/messui-windows-gcc-5d220f084d19ffdbacf49c710320cdce0dd00fb5.zip",
    "hash": "b818fad287b00c1604e09a60394468fcbe59b64e91791d7033332be59edb3e97",
    "bin": [
        [
            "messui.exe",
            "messui-dev"
        ]
    ],
    "shortcuts": [
        [
            "messui.exe",
            "MESSUI (dev)"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Robbbert/messui/actions/workflows/ci-messui.yml/runs?branch=master&event=push&status=success&per_page=1",
        "script": [
            "$run = json_path $page $.workflow_runs[0].run_number",
            "$id = json_path $page $.workflow_runs[0].id",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "Write-Output \"$run $id $date $sha\""
        ],
        "regex": "^(?<run>\\d+) (?<id>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<short>[0-9a-f]{7})(?<rest>[0-9a-f]+)$",
        "replace": "${run}-${year}${month}${day}-${short}"
    },
    "autoupdate": {
        "url": "https://nightly.link/Robbbert/messui/actions/runs/$matchId/messui-windows-gcc-$matchShort$matchRest.zip"
    }
}
