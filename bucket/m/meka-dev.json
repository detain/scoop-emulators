    "bin": [
        [
            "mekaw.exe",
            "meka-dev"
        ]
    ],
    "shortcuts": [
        [
            "mekaw.exe",
            "MEKA (dev)"
        ]
    ],
    "checkver": {
        "url": "https://ci.appveyor.com/api/projects/ocornut/meka",
        "script": [
            "$j = $page | ConvertFrom-Json",
            "$b = $j.build",
            "$d = ([datetime]$b.committed).ToUniversalTime().ToString('yyyyMMdd')",
            "Write-Output \"$($b.status) $($b.jobs[0].jobId) $($b.buildNumber) $d $($b.commitId)\""
        ],
        "regex": "^success (?<job>\\w+) (?<build>\\d+) (?<date>\\d{8}) (?<commit>[0-9a-f]{7})",
        "replace": "${build}-${date}-${commit}"
    },
    "autoupdate": {
        "url": "https://ci.appveyor.com/api/buildjobs/$matchJob/artifacts/meka/Dist/mekaw.zip"
    }
}
