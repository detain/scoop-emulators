    "checkver": {
        "github": "https://api.github.com/repos/mupen64plus/mupen64plus-core/releases/tags/nightly-build",
        "script": [
            "$h = @{}",
            "$t = Get-GitHubToken",
            "if ($t) { $h['Authorization'] = \"token $t\" }",
            "$dates = @()",
            "$ids = @()",
            "foreach ($c in 'core', 'ui-console', 'audio-sdl', 'input-sdl', 'rsp-hle', 'video-rice', 'video-glide64mk2') {",
            "    $r = Invoke-RestMethod -Headers $h -Uri \"https://api.github.com/repos/mupen64plus/mupen64plus-$c/releases/tags/nightly-build\"",
            "    $a = $r.assets | Where-Object { $_.name -match '-msvc-x64-g[0-9a-f]+\\.zip$' } | Select-Object -First 1",
            "    $ids += [regex]::Match($a.name, '-(g[0-9a-f]+)\\.zip$').Groups[1].Value",
            "    $dates += ([datetime]$a.updated_at).ToUniversalTime().ToString('yyyyMMdd')",
            "}",
            "Write-Output \"$(($dates | Sort-Object)[-1]) $($ids -join ' ')\""
        ],
        "regex": "^(?<date>\\d{8}) (?<core>g[0-9a-f]+) (?<ui>g[0-9a-f]+) (?<audio>g[0-9a-f]+) (?<input>g[0-9a-f]+) (?<rsp>g[0-9a-f]+) (?<rice>g[0-9a-f]+) (?<glide>g[0-9a-f]+)$",
        "replace": "${date}-${core}"
    },
