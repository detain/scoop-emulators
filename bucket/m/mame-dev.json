{
    "version": "41816-20261113-98ff9fd",
    "description": "Arcade machine emulator (development version)",
    "homepage": "https://www.mamedev.org/",
    "license": "GPL-2.0-or-later",
    "notes": [
        "Development builds come from the MAME GitHub Actions CI (via nightly.link) and contain only mame.exe, chdman.exe and unidasm.exe.",
        "Support files shipped with releases (plugins, hash, bgfx, artwork, language) are not included.",
        "CI artifacts expire about 90 days after they are built."
    ],
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/mamedev/mame/actions/runs/43505950378/mame-windows-gcc-x64-98ff9fd1848712350fe31b682d6b587c3f16b19d.zip",
            "hash": "f655e8df51699f3550d08806a463464a13f035aee80b4e8fd133352a41fb9e5e"
        },
        "arm64": {
            "url": "https://nightly.link/mamedev/mame/actions/runs/43505950378/mame-windows-clang-arm64-98ff9fd1848712350fe31b682d6b587c3f16b19d.zip",
            "hash": "1e8ac8bbd6bc6e7ed67b73f7a8e28e298bdcd05f6c294bd179b784045e36294f"
        }
    },
    "bin": [
        [
            "mame.exe",
            "mame-dev"
        ],
        [
            "chdman.exe",
            "chdman-dev"
        ],
        [
            "unidasm.exe",
            "unidasm-dev"
        ]
    ],
    "shortcuts": [
        [
            "mame.exe",
            "MAME (dev)"
        ]
    ],
    "persist": [
        "roms",
        "cfg",
        "nvram"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/mamedev/mame/actions/workflows/ci-windows.yml/runs?branch=master&event=push&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runNumber = json_path $page $.workflow_runs[0].run_number",
            "$runId = json_path $page $.workflow_runs[0].id",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runNumber $date $sha $runId\""
        ],
        "regex": "^(?<num>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<sha>(?<short>[0-9a-f]{7})[0-9a-f]{33}) (?<id>\\d+)$",
        "replace": "${num}-${year}${month}${day}-${short}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/mamedev/mame/actions/runs/$matchId/mame-windows-gcc-x64-$matchSha.zip"
            },
            "arm64": {
                "url": "https://nightly.link/mamedev/mame/actions/runs/$matchId/mame-windows-clang-arm64-$matchSha.zip"
            }
        }
    }
}
