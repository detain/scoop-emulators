{
    "version": "615-20261112-4dd0593",
    "description": "HomeBrew MAME: MAME derivative with hacks and homebrew games not included in MAME (development version)",
    "homepage": "http://hbmame.1emulation.com/",
    "license": "GPL-2.0-only",
    "notes": [
        "Development builds come from GitHub Actions artifacts (via nightly.link), which expire about 28 days after the build.",
        "The artifact contains only hbmame.exe (no plugins, language or hash files)."
    ],
    "url": "https://nightly.link/Robbbert/hbmame/actions/runs/43227298268/hbmame-windows-gcc-4dd05939fa2c723c011eab20c6aae8e19b5b3a00.zip",
    "hash": "6deea5fff70417c732b28c49030f4ed369983742a8292bf4c9f131fd951d68c5",
    "bin": [
        [
            "hbmame.exe",
            "hbmame-dev"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/Robbbert/hbmame/actions/workflows/ci-hbmame.yml/runs?branch=master&status=success&per_page=1",
        "script": [
            "$run = json_path $page $.workflow_runs[0].run_number",
            "$id = json_path $page $.workflow_runs[0].id",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "Write-Output \"$run $id $date $sha\""
        ],
        "regex": "^(?<run>\\d+) (?<id>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<short>[0-9a-f]{7})(?<rest>[0-9a-f]+)$",
        "replace": "${run}-${year}${month}${day}-${short}"
    },
    "autoupdate": {
        "url": "https://nightly.link/Robbbert/hbmame/actions/runs/$matchId/hbmame-windows-gcc-$matchShort$matchRest.zip"
    }
}
