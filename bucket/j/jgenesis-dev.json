{
    "version": "1412-20261106-386db85",
    "description": "Multi-console emulator for Sega Genesis/CD/32X, Master System, Game Gear, NES, SNES, Game Boy/GBA and PC Engine (development version)",
    "homepage": "https://github.com/jsgroth/jgenesis",
    "license": "GPL-3.0-only",
    "notes": "Development builds come from GitHub Actions artifacts (via nightly.link), which expire after about 90 days.",
    "url": "https://nightly.link/jsgroth/jgenesis/workflows/rust/master/windows-x86_64-exe.zip",
    "hash": "cf63420364396cbbcea861ad09c7cd9396a7e19d071171e5a535ec15f35cb2a2",
    "pre_install": [
        "Get-ChildItem \"$dir\\jgenesis-*-windows-x86_64.zip\" | ForEach-Object {",
        "    Expand-ZipArchive $_.FullName $dir -Removal",
        "}"
    ],
    "bin": [
        [
            "jgenesis.exe",
            "jgenesis-dev"
        ]
    ],
    "shortcuts": [
        [
            "jgenesis.exe",
            "jgenesis (dev)"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/jsgroth/jgenesis/actions/workflows/rust.yml/runs?branch=master&status=success&event=push",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<version>[^ ]+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})[^ ]+ (?<hash>.{7})(?<rest>.*)$",
        "replace": "${version}-${year}${month}${day}-${hash}"
    },
    "autoupdate": {
        "url": "https://nightly.link/jsgroth/jgenesis/workflows/rust/master/windows-x86_64-exe.zip"
    }
}
