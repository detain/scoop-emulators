{
    "version": "7.0c",
    "description": "Atari 2600 VCS emulator",
    "homepage": "https://stella-emu.github.io",
    "license": "GPL-2.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/stella-emu/stella/releases/download/7.0/Stella-7.0c-windows.zip",
            "hash": "44102ccf8af74b021cf143db346e561c5d6ed2a2e91d79ee6d3c99d7c42f4653"
        }
    },
    "extract_dir": "Stella-7.0c",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\stella.sqlite3\")) {",
        "    New-Item \"$dir\\stella.sqlite3\" -Type File | Out-Null",
        "}"
    ],
    "bin": [
        [
            "Stella.exe",
            "stella",
            "-baseinappdir"
        ]
    ],
    "shortcuts": [
        [
            "Stella.exe",
            "Stella",
            "-baseinappdir"
        ]
    ],
    "persist": [
        "nvram",
        "state",
        "stella.sqlite3"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/stella-emu/stella/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "download/(?<tag>[^/]+)/Stella-(?<version>[\\w.]+)-windows\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/stella-emu/stella/releases/download/$matchTag/Stella-$version-windows.zip"
            }
        },
        "extract_dir": "Stella-$version"
    }
}
