    "checkver": {
        "github": "https://api.github.com/repos/skylersaleh/SkyEmu/actions/workflows/deploy_win.yml/runs?branch=dev&event=push&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
