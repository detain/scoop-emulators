{
    "version": "1.2.39",
    "description": "Atari Lynx emulator, debugger and embedded MCP server",
    "homepage": "https://github.com/drhelius/Gearlynx",
    "license": "GPL-3.0-only",
    "notes": "Gearlynx requires an Atari Lynx BIOS (lynxboot.img); load it from the Emulator menu.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/drhelius/Gearlynx/releases/download/1.2.39/Gearlynx-1.2.39-desktop-windows-x64.zip",
            "hash": "82adba91a29675056052e1bb20cb808d653dd763761f211db8dbd534c985bc49"
        },
        "arm64": {
            "url": "https://github.com/drhelius/Gearlynx/releases/download/1.2.39/Gearlynx-1.2.39-desktop-windows-arm64.zip",
            "hash": "b9d9df1cdf9d4d52b2a8167f475df37d3510bfc456b25a22922f6407c0accfc5"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": "Gearlynx.exe",
    "shortcuts": [
        [
            "Gearlynx.exe",
            "Gearlynx"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/drhelius/Gearlynx/releases/download/$version/Gearlynx-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/drhelius/Gearlynx/releases/download/$version/Gearlynx-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
