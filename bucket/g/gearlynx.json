{
    "version": "1.2.40",
    "description": "Atari Lynx emulator, debugger and embedded MCP server",
    "homepage": "https://github.com/drhelius/Gearlynx",
    "license": "GPL-3.0-only",
    "notes": "Gearlynx requires an Atari Lynx BIOS (lynxboot.img); load it from the Emulator menu.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/drhelius/Gearlynx/releases/download/1.2.40/Gearlynx-1.2.40-desktop-windows-x64.zip",
            "hash": "2942e3d6b5c3f8fab9377a30ff5637f9b303407e476da9279f8ecf68f18306da"
        },
        "arm64": {
            "url": "https://github.com/drhelius/Gearlynx/releases/download/1.2.40/Gearlynx-1.2.40-desktop-windows-arm64.zip",
            "hash": "e8da2a092e5054384b7688d227ed5100f044769c838f5b12d94291904b3cdd0d"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": "Gearlynx.exe",
    "shortcuts": [
        [
            "Gearlynx.exe",
            "Gearlynx"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/drhelius/Gearlynx/releases/download/$version/Gearlynx-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/drhelius/Gearlynx/releases/download/$version/Gearlynx-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
