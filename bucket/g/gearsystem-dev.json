{
    "version": "3.9.25-14-g4b3b1b2",
    "description": "Sega Master System / Game Gear / SG-1000 emulator and debugger (development version)",
    "homepage": "https://github.com/drhelius/Gearsystem",
    "license": "GPL-3.0-or-later",
    "notes": "Development builds come from GitHub Actions artifacts (via nightly.link), which expire after about 90 days.",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-3.9.25-14-g4b3b1b2-desktop-windows-x64.zip",
            "hash": "81f73718948633f4e074f16b2a4b709c662883fbba22340803055b1be5bd59d3"
        },
        "arm64": {
            "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-3.9.25-14-g4b3b1b2-desktop-windows-arm64.zip",
            "hash": "2254b192ac64cd547467cbbb63ffc89ffd4e692ce37e1f04817f6e37294abd1b"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": [
        [
            "Gearsystem.exe",
            "gearsystem-dev"
        ]
    ],
    "shortcuts": [
        [
            "Gearsystem.exe",
            "Gearsystem (dev)"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": {
        "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master",
        "regex": "Gearsystem-([\\d.]+(?:-\\d+-g[0-9a-f]+)?)-desktop-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
