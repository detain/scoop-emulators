            "hash": "a2a462fa4d456437391c78f56053a511b985717862adf6f138b3642ce2646fae"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": [
        [
            "Gearsystem.exe",
            "gearsystem-dev"
        ]
    ],
    "shortcuts": [
        [
            "Gearsystem.exe",
            "Gearsystem (dev)"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": {
        "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master",
        "regex": "Gearsystem-([\\d.]+(?:-\\d+-g[0-9a-f]+)?)-desktop-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-$version-desktop-windows-arm64.zip"
            }
        }
    }
