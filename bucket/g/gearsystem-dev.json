    "license": "GPL-3.0-or-later",
    "notes": "Development builds come from GitHub Actions artifacts (via nightly.link), which expire after about 90 days.",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-3.9.26-3-g2fdd8f7-desktop-windows-x64.zip",
            "hash": "b7cf11de8093078324a13bc85e980bf79fe8acb5a6bcf7240bf70d00846134de"
        },
        "arm64": {
            "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-3.9.26-3-g2fdd8f7-desktop-windows-arm64.zip",
            "hash": "02331637d6833395afc52d9a6afe50a13a2944ddfd3703cce96125d45568f585"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": [
        [
            "Gearsystem.exe",
            "gearsystem-dev"
        ]
    ],
    "shortcuts": [
        [
            "Gearsystem.exe",
            "Gearsystem (dev)"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": {
        "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master",
        "regex": "Gearsystem-([\\d.]+(?:-\\d+-g[0-9a-f]+)?)-desktop-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/drhelius/Gearsystem/workflows/gearsystem/master/Gearsystem-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
