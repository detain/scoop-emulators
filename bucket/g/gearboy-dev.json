    "license": "GPL-3.0-or-later",
    "notes": "Development builds come from GitHub Actions artifacts (via nightly.link), which expire after about 90 days.",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/drhelius/Gearboy/workflows/gearboy/master/Gearboy-3.8.20-15-gbd0c3e2-desktop-windows-x64.zip",
            "hash": "1d97b7997faa7db0822cfa681a8f07567440dc2c01569600058c5bc8ed48a1cf"
        },
        "arm64": {
            "url": "https://nightly.link/drhelius/Gearboy/workflows/gearboy/master/Gearboy-3.8.20-15-gbd0c3e2-desktop-windows-arm64.zip",
            "hash": "b3ba4d715c622b7ced15d7bdec536916e7d164a9a5075477e9ab5a4696258193"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": [
        [
            "Gearboy.exe",
            "gearboy-dev"
        ]
    ],
    "shortcuts": [
        [
            "Gearboy.exe",
            "Gearboy (dev)"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": {
        "url": "https://nightly.link/drhelius/Gearboy/workflows/gearboy/master",
        "regex": "Gearboy-([\\d.]+(?:-\\d+-g[0-9a-f]+)?)-desktop-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/drhelius/Gearboy/workflows/gearboy/master/Gearboy-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/drhelius/Gearboy/workflows/gearboy/master/Gearboy-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
