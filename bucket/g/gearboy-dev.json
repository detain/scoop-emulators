            "hash": "87a9c8f0058775e492c5d60dbf5714296a6afb1816225a018ee9d3967bf90327"
        },
        "arm64": {
            "url": "https://nightly.link/drhelius/Gearboy/workflows/gearboy/master/Gearboy-3.8.20-14-g73baade-desktop-windows-arm64.zip",
            "hash": "d6373cb94f7985c54e0349f612915be6f65a52d720a4ac16f1d69f6650e46579"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": [
        [
            "Gearboy.exe",
            "gearboy-dev"
        ]
    ],
    "shortcuts": [
        [
            "Gearboy.exe",
            "Gearboy (dev)"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": {
        "url": "https://nightly.link/drhelius/Gearboy/workflows/gearboy/master",
        "regex": "Gearboy-([\\d.]+(?:-\\d+-g[0-9a-f]+)?)-desktop-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/drhelius/Gearboy/workflows/gearboy/master/Gearboy-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/drhelius/Gearboy/workflows/gearboy/master/Gearboy-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
