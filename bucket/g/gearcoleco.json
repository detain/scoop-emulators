{
    "version": "1.8.1",
    "description": "ColecoVision emulator and debugger",
    "homepage": "https://github.com/drhelius/Gearcoleco",
    "license": "GPL-3.0-or-later",
    "notes": "Gearcoleco requires a ColecoVision BIOS (colecovision.rom); load it from the Emulator menu.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/drhelius/Gearcoleco/releases/download/1.8.1/Gearcoleco-1.8.1-desktop-windows-x64.zip",
            "hash": "3cc42f1d6613fb3e79383d9192d695b1a31b56073d9fc825be354d771f8d4374"
        },
        "arm64": {
            "url": "https://github.com/drhelius/Gearcoleco/releases/download/1.8.1/Gearcoleco-1.8.1-desktop-windows-arm64.zip",
            "hash": "6590e4ff667a15e6c8c23aa599ebde2bb49f9162f479bcd890d084b4add1d225"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": "Gearcoleco.exe",
    "shortcuts": [
        [
            "Gearcoleco.exe",
            "Gearcoleco"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/drhelius/Gearcoleco/releases/download/$version/Gearcoleco-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/drhelius/Gearcoleco/releases/download/$version/Gearcoleco-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
