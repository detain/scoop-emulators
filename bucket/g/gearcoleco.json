{
    "version": "1.8.0",
    "description": "ColecoVision emulator and debugger",
    "homepage": "https://github.com/drhelius/Gearcoleco",
    "license": "GPL-3.0-or-later",
    "notes": "Gearcoleco requires a ColecoVision BIOS (colecovision.rom); load it from the Emulator menu.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/drhelius/Gearcoleco/releases/download/1.8.0/Gearcoleco-1.8.0-desktop-windows-x64.zip",
            "hash": "bcae27da3d587d533b60ee9458bdc034c0ba0a26f0288bba24b20aa8c8389468"
        },
        "arm64": {
            "url": "https://github.com/drhelius/Gearcoleco/releases/download/1.8.0/Gearcoleco-1.8.0-desktop-windows-arm64.zip",
            "hash": "e991d52013e031888b2cf0dcaf7c1ec3dca2b12848ea43e9b3b91c43ee02da62"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": "Gearcoleco.exe",
    "shortcuts": [
        [
            "Gearcoleco.exe",
            "Gearcoleco"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/drhelius/Gearcoleco/releases/download/$version/Gearcoleco-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/drhelius/Gearcoleco/releases/download/$version/Gearcoleco-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
