    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\portable.txt\")) {",
        "    New-Item \"$dir\\portable.txt\" -Type File | Out-Null",
        "}"
    ],
    "persist": [
        "portable.txt",
        "portable_data"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/gopher64/gopher64/actions/workflows/build.yml/runs?branch=main&status=success&event=push",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<version>[^ ]+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})[^ ]+ (?<hash>.{7})(?<rest>.*)$",
        "replace": "${version}-${year}${month}${day}-${hash}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/gopher64/gopher64/workflows/build/main/gopher64-windows-x86_64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/gopher64/gopher64/workflows/build/main/gopher64-windows-aarch64.zip"
            }
        }
    }
