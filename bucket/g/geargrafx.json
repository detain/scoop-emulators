{
    "version": "1.8.9",
    "description": "NEC PC Engine / TurboGrafx-16 / SuperGrafx / PCE CD-ROM2 emulator and debugger",
    "homepage": "https://github.com/drhelius/Geargrafx",
    "license": "GPL-3.0-or-later",
    "notes": "CD-ROM2 games require a System Card BIOS; load it from the Emulator menu.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/drhelius/Geargrafx/releases/download/1.8.9/Geargrafx-1.8.9-desktop-windows-x64.zip",
            "hash": "6e8901aab822393b6ecceb43e456b2d77bd10f587095a866110ee66897fee364"
        },
        "arm64": {
            "url": "https://github.com/drhelius/Geargrafx/releases/download/1.8.9/Geargrafx-1.8.9-desktop-windows-arm64.zip",
            "hash": "b37260343cf49571a19b1987a9f10ee658779d8bf0f098b55abc3eb3c7f220b3"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": "Geargrafx.exe",
    "shortcuts": [
        [
            "Geargrafx.exe",
            "Geargrafx"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/drhelius/Geargrafx/releases/download/$version/Geargrafx-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/drhelius/Geargrafx/releases/download/$version/Geargrafx-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
