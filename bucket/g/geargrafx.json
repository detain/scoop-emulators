{
    "version": "1.8.8",
    "description": "NEC PC Engine / TurboGrafx-16 / SuperGrafx / PCE CD-ROM2 emulator and debugger",
    "homepage": "https://github.com/drhelius/Geargrafx",
    "license": "GPL-3.0-or-later",
    "notes": "CD-ROM2 games require a System Card BIOS; load it from the Emulator menu.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/drhelius/Geargrafx/releases/download/1.8.8/Geargrafx-1.8.8-desktop-windows-x64.zip",
            "hash": "b32a919571e6d10b614175a191f8fe20ff12ef584bd722c57c38b117d19d7e55"
        },
        "arm64": {
            "url": "https://github.com/drhelius/Geargrafx/releases/download/1.8.8/Geargrafx-1.8.8-desktop-windows-arm64.zip",
            "hash": "879171be4dbb6c506b0f8288a6e556259bc5b73cef7fff7eddf3a2c22d0de06f"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": "Geargrafx.exe",
    "shortcuts": [
        [
            "Geargrafx.exe",
            "Geargrafx"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/drhelius/Geargrafx/releases/download/$version/Geargrafx-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/drhelius/Geargrafx/releases/download/$version/Geargrafx-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
