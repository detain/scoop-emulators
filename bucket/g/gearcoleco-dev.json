            "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-1.7.6-12-g8b716ef-desktop-windows-x64.zip",
            "hash": "6a6eb02480582270a734df4c4579e2ee8a2d0eafc1a3ba6c0a5e7c05fea2f119"
        },
        "arm64": {
            "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-1.7.6-12-g8b716ef-desktop-windows-arm64.zip",
            "hash": "f003aaae4c1a51bcca38bb9379b81148159d29df747a9cf2bd9918d64a52ed7b"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": [
        [
            "Gearcoleco.exe",
            "gearcoleco-dev"
        ]
    ],
    "shortcuts": [
        [
            "Gearcoleco.exe",
            "Gearcoleco (dev)"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": {
        "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main",
        "regex": "Gearcoleco-([\\d.]+(?:-\\d+-g[0-9a-f]+)?)-desktop-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
