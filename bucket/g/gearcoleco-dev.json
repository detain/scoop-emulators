    "license": "GPL-3.0-or-later",
    "notes": "Development builds come from GitHub Actions artifacts (via nightly.link), which expire after about 90 days.",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-1.8.1-3-g1420e70-desktop-windows-x64.zip",
            "hash": "de40bd509af0d147853ecf02db67bb282b14dad346a6e24b1bab338739565ece"
        },
        "arm64": {
            "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-1.8.1-3-g1420e70-desktop-windows-arm64.zip",
            "hash": "8cd1b755cc01f5875942b7852d1060bc0e3689866a776aea6463bcbec748ebad"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": [
        [
            "Gearcoleco.exe",
            "gearcoleco-dev"
        ]
    ],
    "shortcuts": [
        [
            "Gearcoleco.exe",
            "Gearcoleco (dev)"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": {
        "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main",
        "regex": "Gearcoleco-([\\d.]+(?:-\\d+-g[0-9a-f]+)?)-desktop-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
