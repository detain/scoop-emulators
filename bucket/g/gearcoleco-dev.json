    "license": "GPL-3.0-or-later",
    "notes": "Development builds come from GitHub Actions artifacts (via nightly.link), which expire after about 90 days.",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-1.8.1-10-ge1b9038-desktop-windows-x64.zip",
            "hash": "275776570c75a5c8d034434547a30b3f1a1a301b99b9e83211be37e3a2b988d1"
        },
        "arm64": {
            "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-1.8.1-10-ge1b9038-desktop-windows-arm64.zip",
            "hash": "bed5676e4562f7f9085828cb41983ce26508519796cc7a784035c666feec0e1a"
        }
    },
    "pre_install": [
        "foreach ($f in @('portable.ini', 'config.ini', 'imgui.ini')) {",
        "    if (!(Test-Path \"$persist_dir\\$f\")) {",
        "        New-Item \"$dir\\$f\" -Type File | Out-Null",
        "    }",
        "}"
    ],
    "bin": [
        [
            "Gearcoleco.exe",
            "gearcoleco-dev"
        ]
    ],
    "shortcuts": [
        [
            "Gearcoleco.exe",
            "Gearcoleco (dev)"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": {
        "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main",
        "regex": "Gearcoleco-([\\d.]+(?:-\\d+-g[0-9a-f]+)?)-desktop-windows-x64\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-$version-desktop-windows-x64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main/Gearcoleco-$version-desktop-windows-arm64.zip"
            }
        }
    }
}
