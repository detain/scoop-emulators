            "Gearcoleco.exe",
            "Gearcoleco (dev)"
        ]
    ],
    "persist": [
        "portable.ini",
        "config.ini",
        "imgui.ini"
    ],
    "checkver": {
        "url": "https://nightly.link/drhelius/Gearcoleco/workflows/gearcoleco/main",
