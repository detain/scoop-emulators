    "bin": [
        [
            "erings.exe",
            "erings-dev"
        ]
    ],
    "shortcuts": [
        [
            "erings.exe",
            "erings (dev)"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/user-none/erings/actions/workflows/build.yml/runs?branch=main&status=success&event=push",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<version>[^ ]+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})[^ ]+ (?<hash>.{7})(?<rest>.*)$",
        "replace": "${version}-${year}${month}${day}-${hash}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/user-none/erings/workflows/build/main/erings-$matchHash-windows-amd64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/user-none/erings/workflows/build/main/erings-$matchHash-windows-arm64.zip"
            }
        }
    }
}
