    "license": "GPL-3.0-only",
    "notes": [
        "A built-in HLE BIOS is used by default; a real Saturn BIOS (USA or Japan) is optional.",
        "Development builds come from GitHub Actions artifacts (via nightly.link), which expire after about 90 days."
    ],
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/user-none/erings/workflows/build/main/erings-6e60d8c-windows-amd64.zip",
            "hash": "2b1d313311f23eb9c4b81fa0f42ad0b4a0ca5740ef901ae52b6cd7dcbfc446d8"
        },
        "arm64": {
            "url": "https://nightly.link/user-none/erings/workflows/build/main/erings-6e60d8c-windows-arm64.zip",
            "hash": "c82d4793cb979c615cd638b900233621020c72c5bde0909f7271738f7039aa90"
        }
    },
    "bin": [
        [
            "erings.exe",
            "erings-dev"
        ]
    ],
    "shortcuts": [
        [
            "erings.exe",
            "erings (dev)"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/user-none/erings/actions/workflows/build.yml/runs?branch=main&status=success&event=push",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<version>[^ ]+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})[^ ]+ (?<hash>.{7})(?<rest>.*)$",
        "replace": "${version}-${year}${month}${day}-${hash}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/user-none/erings/workflows/build/main/erings-$matchHash-windows-amd64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/user-none/erings/workflows/build/main/erings-$matchHash-windows-arm64.zip"
            }
        }
    }
}
