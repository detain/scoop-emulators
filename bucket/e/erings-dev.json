            "hash": "98bb54ca4cde63fa54d5f73d6033902b703bb907b43adf9020c6a140ff52aff2"
        },
        "arm64": {
            "url": "https://nightly.link/user-none/erings/workflows/build/main/erings-705bbe7-windows-arm64.zip",
