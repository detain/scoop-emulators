    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "url": "https://git.eden-emu.dev/Takoroka/eden-nx2/releases/download/nx2-2026-10-29/Eden-Windows-nx2-2026-10-29-amd64-msvc-standard.zip",
    "hash": "be64e20df9464b633d83e1dcb1a55bfb05682adc8121ac6fd50c6747eb2f9e58",
    "bin": [
        [
            "eden.exe",
            "eden-nx2"
        ]
    ],
    "shortcuts": [
        [
            "eden.exe",
            "Eden NX2"
        ]
    ],
    "persist": "user",
    "checkver": {
        "url": "https://git.eden-emu.dev/api/v1/repos/Takoroka/eden-nx2/releases?limit=1",
