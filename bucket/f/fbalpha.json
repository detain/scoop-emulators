{
    "##": [
        "name:FinalBurn Alpha",
        "author:The FinalBurn Alpha Team",
        "cmd:%BIN% %ROM%",
        "logo:https://consolo.is.cc/images/emuDownloadCenter/hooks/fbalpha/emulator_logo.png",
        "screenshot:https://consolo.is.cc/images/emuDownloadCenter/hooks/fbalpha/emulator_screen_01.jpg"
    ],
    "version": "0.2.97.43",
    "description": "Arcade emulator (CPS1/2/3, Neo Geo, Cave, Toaplan, Sega System 16 and more); predecessor of FinalBurn Neo",
    "homepage": "http://www.fbalpha.com",
    "license": "Freeware",
    "notes": "FB Alpha is discontinued and its site is gone; downloads come from the Internet Archive (served gzip-wrapped, unpacked in pre_install). Consider fbneo instead.",
    "architecture": {
        "32bit": {
            "url": "https://web.archive.org/web/2022id_/https://static.fbalpha.com/files/fba_029743.7z#/fba.7z.gz",
            "hash": "0aca5e62444baa90eec9a1c23ef9a48acb78def6cf3b307c3ccfca612a6949fb",
            "bin": "fba.exe",
            "shortcuts": [
                [
                    "fba.exe",
                    "FinalBurn Alpha"
                ]
            ]
        },
        "64bit": {
            "url": "https://web.archive.org/web/2023id_/https://static.fbalpha.com/files/fba64_029743.7z#/fba64.7z.gz",
            "hash": "ce7afb417a6a3054086ebf89459d39fe0105b532b678d1efd398650800ff9276",
            "bin": "fba64.exe",
            "shortcuts": [
                [
                    "fba64.exe",
                    "FinalBurn Alpha"
                ]
            ]
        }
    },
    "pre_install": "Get-ChildItem \"$dir\\*.7z\" | ForEach-Object { Expand-7zipArchive -Path $_.FullName -DestinationPath \"$dir\" -Removal }",
    "checkver": {
        "url": "https://web.archive.org/web/20240710050625/https://www.fbalpha.com/downloads/",
        "regex": "Current Version: <span class=\"bold\">(?<version>[\\d\\.]+)<"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://web.archive.org/web/2022id_/https://static.fbalpha.com/files/fba_$cleanVersion.7z#/fba.7z.gz"
            },
            "64bit": {
                "url": "https://web.archive.org/web/2023id_/https://static.fbalpha.com/files/fba64_$cleanVersion.7z#/fba64.7z.gz"
            }
        }
    }
}
