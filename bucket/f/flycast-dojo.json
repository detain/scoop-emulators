{
    "version": "7.9",
    "description": "Sega Dreamcast, Naomi and Atomiswave emulator; Flycast fork focused on netplay and replays",
    "homepage": "https://flycast.dojo.ooo/",
    "license": "GPL-2.0-only",
    "url": "https://github.com/blueminder/flycast-dojo/releases/download/dojo-7.9/flycast-dojo-windows.zip",
    "hash": "92cba733d93f883568c2f55eadd55858ce55e0806c4dd810f0e9c48a1c8c4295",
    "pre_install": "if (!(Test-Path \"$persist_dir\\emu.cfg\")) { New-Item -ItemType File \"$dir\\emu.cfg\" | Out-Null }",
    "bin": [
        [
            "flycast.exe",
            "flycast-dojo"
        ]
    ],
    "shortcuts": [
        [
            "flycast.exe",
            "Flycast Dojo"
        ]
    ],
    "persist": [
        "emu.cfg",
        "data",
        "mappings"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/blueminder/flycast-dojo/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "dojo-([\\d\\.]+)"
    },
    "autoupdate": {
        "url": "https://github.com/blueminder/flycast-dojo/releases/download/dojo-$version/flycast-dojo-windows.zip"
    }
}
