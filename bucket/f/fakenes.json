{
    "##": [
        "name:FakeNES",
        "author:randilyn, TRAC, Lord_Nightmare and KittyCat",
        "cmd:%BIN% %ROM%",
        "logo:https://consolo.is.cc/images/emuDownloadCenter/hooks/fakenes/emulator_logo.png",
        "screenshot:https://consolo.is.cc/images/emuDownloadCenter/hooks/fakenes/emulator_screen_01.jpg"
    ],
    "version": "0.5.9b3",
    "description": "Nintendo Entertainment System and Famicom emulator",
    "homepage": "https://fakenes.sourceforge.net/",
    "license": "Zlib",
    "url": "https://downloads.sourceforge.net/project/fakenes/FakeNES/0.5.9%20beta%203/fakenesw059b3.zip",
    "hash": "sha1:680b0a6b91af1c0d9e7fcc4f00fe7cfe55078161",
    "bin": [
        [
            "fakenesw.exe",
            "fakenes"
        ]
    ],
    "shortcuts": [
        [
            "fakenesw.exe",
            "FakeNES"
        ]
    ],
    "persist": "fakenesw.cfg",
    "checkver": {
        "url": "https://sourceforge.net/projects/fakenes/rss?path=/FakeNES",
        "regex": "FakeNES/(?<ver>[\\d.]+) beta (?<beta>\\d+)/fakenesw(?<clean>\\d+)b\\d+\\.zip",
        "replace": "${ver}b${beta}"
    },
    "autoupdate": {
        "url": "https://downloads.sourceforge.net/project/fakenes/FakeNES/$matchVer%20beta%20$matchBeta/fakenesw$matchCleanb$matchBeta.zip"
    }
}
