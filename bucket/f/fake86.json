        }
    },
    "bin": [
        "fake86.exe",
        "fake86-net.exe",
        "imagegen.exe"
    ],
    "checkver": {
        "url": "https://sourceforge.net/projects/fake86/rss",
        "regex": "fake86-([\\d.]+)-win32\\.zip"
    },
    "autoupdate": {
        "architecture": {
