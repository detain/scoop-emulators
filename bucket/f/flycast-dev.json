{
    "version": "3596-20261108-1b7c7d6",
    "description": "Sega Dreamcast, Naomi, Naomi 2 and Atomiswave emulator (development version)",
    "homepage": "https://github.com/flyinghead/flycast",
    "license": "GPL-2.0-only",
    "architecture": {
        "64bit": {
            "url": "https://flycast-builds.s3.fr-par.scw.cloud/win/heads/master-1b7c7d63b73ea6987fb23f9334a7d597401a50f8/flycast.zip",
            "hash": "4b9689b1b6c741f6d9502575cfebec1928cd691d3e55570f73ff55d7d60b71b0"
        }
    },
    "pre_install": "if (!(Test-Path \"$persist_dir\\emu.cfg\")) { New-Item -ItemType File \"$dir\\emu.cfg\" | Out-Null }",
    "bin": [
        [
            "flycast.exe",
            "flycast-dev"
        ]
    ],
    "shortcuts": [
        [
            "flycast.exe",
            "Flycast (dev)"
        ]
    ],
    "persist": [
        "emu.cfg",
        "data",
        "mappings"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/flyinghead/flycast/actions/workflows/c-cpp.yml/runs?branch=master&event=push&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<version>[^ ]+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})[^ ]+ (?<hash>.{7})(?<rest>.*)$",
        "replace": "${version}-${year}${month}${day}-${hash}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://flycast-builds.s3.fr-par.scw.cloud/win/heads/master-$matchHash$matchRest/flycast.zip"
            }
        }
    }
}
