{
    "version": "848-20251231-2ed5b1b",
    "description": "Qt-based Nintendo Entertaiment System emulator and NSF/NSFe Music Player (OpenGL Version)",
    "homepage": "https://github.com/punesemu/puNES",
    "license": "GPL-2.0-only",
    "architecture": {
        "32bit": {
            "url": "https://nightly.link/punesemu/puNES/workflows/build/master/punes32.wip.opengl.zip",
            "hash": "74dd23bc96000f365bb239ee12acb952093e1f11e3fdf11d7c7bca7f6653d9af"
        },
        "64bit": {
            "url": "https://nightly.link/punesemu/puNES/workflows/build/master/punes64.wip.opengl.zip",
            "hash": "876b3eb12f2ecc6d632c9f7a64d13e8cfacb7e822edb9ce4e98c144271b39276"
        }
    },
    "pre_install": [
        "'input.cfg', 'puNES.cfg', 'recent.cfg' | ForEach-Object {",
        "    if (!(Test-Path \"$persist_dir\\$_\")) { New-Item \"$dir\\$_\" -ItemType File | Out-Null }",
        "}"
    ],
    "bin": [
        [
            "punes.exe",
            "punes-opengl-dev",
            "--portable"
        ]
    ],
    "shortcuts": [
        [
            "punes.exe",
            "puNES (OpenGL) (dev)",
            "--portable"
        ]
    ],
    "persist": [
        "bios",
        "cheat",
        "diff",
        "jsc",
        "pgs",
        "prb",
        "save",
        "screenshot",
        "shp",
        "tmp",
        "input.cfg",
        "puNES.cfg",
        "recent.cfg"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/punesemu/puNES/actions/workflows/build.yml/runs?branch=master&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<run>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<commit>[\\da-f]{7})",
        "replace": "${run}-${year}${month}${day}-${commit}"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://nightly.link/punesemu/puNES/workflows/build/master/punes32.wip.opengl.zip"
            },
            "64bit": {
                "url": "https://nightly.link/punesemu/puNES/workflows/build/master/punes64.wip.opengl.zip"
            }
        }
    }
}
