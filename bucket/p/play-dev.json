    "architecture": {
        "32bit": {
            "url": "https://s3.us-east-2.amazonaws.com/playbuilds/1f272327/Play-x86-32.exe#/dl.7z",
            "hash": "1b07b922130e619b215d9991c51861c843c2c9c945f969c82c2c8a9a0099851c"
        },
        "64bit": {
            "url": "https://s3.us-east-2.amazonaws.com/playbuilds/1f272327/Play-x86-64.exe#/dl.7z",
            "hash": "0e32432b9dca5954d89703feafb2f059353498212ea42810d4f824a20e2cc40e"
        }
    },
    "post_install": "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Recurse -Force -ErrorAction SilentlyContinue",
    "bin": [
        [
            "Play.exe",
            "play-dev"
        ]
    ],
    "shortcuts": [
        [
            "Play.exe",
            "Play (dev)"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/jpd002/Play-/actions/workflows/build-windows.yaml/runs?branch=master&status=success&per_page=1",
        "script": [
            "$sha = json_path $page '$.workflow_runs[0].head_sha'",
            "$date = json_path $page '$.workflow_runs[0].created_at'",
            "Write-Output \"$date $sha\""
        ],
        "regex": "^(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<commit>[0-9a-f]{8})",
        "replace": "${year}${month}${day}-${commit}"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://s3.us-east-2.amazonaws.com/playbuilds/$matchCommit/Play-x86-32.exe#/dl.7z"
            },
            "64bit": {
                "url": "https://s3.us-east-2.amazonaws.com/playbuilds/$matchCommit/Play-x86-64.exe#/dl.7z"
            }
        }
    }
}
