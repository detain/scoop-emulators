{
    "version": "176-20261029-030ea8c",
    "description": "Sony PlayStation 2 emulator fork for PS2-based arcade hardware (Konami Python, Namco System 246/256) (development version)",
    "homepage": "https://github.com/DiscoStarslayer/pcsx2-reliquary",
    "license": "GPL-3.0-or-later",
    "notes": [
        "PCSX2 Reliquary requires a PS2 or arcade board BIOS dump.",
        "Place the BIOS files in $persist_dir\\bios",
        "Development builds come from GitHub Actions artifacts (via nightly.link), which expire about 90 days after the last successful master build."
    ],
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "url": "https://nightly.link/DiscoStarslayer/pcsx2-reliquary/workflows/windows_build_matrix/master/PCSX2-windows-Qt-x64-cmake-clang-sha%5B030ea8c%5D.zip",
    "hash": "aec8e51dacc5088af76282743b7c25f4d4b51b532830fdbd541b1428dd95c2d5",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\portable.txt\")) {",
        "    New-Item \"$dir\\portable.txt\" -Type File | Out-Null",
        "}"
    ],
    "bin": [
        [
            "pcsx2-qt-clang.exe",
            "pcsx2-reliquary-dev"
        ]
    ],
    "shortcuts": [
        [
            "pcsx2-qt-clang.exe",
            "PCSX2 Reliquary (dev)"
        ]
    ],
    "persist": [
        "bios",
        "cheats",
        "covers",
        "gamesettings",
        "inis",
        "inputprofiles",
        "logs",
        "memcards",
        "patches",
        "snaps",
        "sstates",
        "textures",
        "videos",
        "portable.txt"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/DiscoStarslayer/pcsx2-reliquary/actions/workflows/windows_build_matrix.yml/runs?branch=master&event=push&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<version>[^ ]+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})[^ ]+ (?<hash>.{7})(?<rest>.*)$",
        "replace": "${version}-${year}${month}${day}-${hash}"
    },
    "autoupdate": {
        "url": "https://nightly.link/DiscoStarslayer/pcsx2-reliquary/workflows/windows_build_matrix/master/PCSX2-windows-Qt-x64-cmake-clang-sha%5B$matchHash%5D.zip"
    }
}
