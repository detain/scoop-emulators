    "pre_install": [
        "Get-ChildItem \"$dir\\pc64w*.exe\" | ForEach-Object {",
        "    Expand-7zipArchive -Path $_.FullName -DestinationPath \"$dir\" -Removal",
        "}"
    ],
    "bin": [
        [
            "PC64WIN.EXE",
            "pc64"
        ]
    ],
    "shortcuts": [
        [
            "PC64WIN.EXE",
            "Personal C64"
        ]
    ],
    "checkver": {
        "url": "http://www.zimmers.net/anonftp/pub/cbm/crossplatform/emulators/msdos/pc64/",
        "regex": "href=\"pc64w(?<major>\\d)(?<minor>\\d+)\\.zip\"",
        "replace": "${major}.${minor}"
    },
    "autoupdate": {
        "url": "http://www.zimmers.net/anonftp/pub/cbm/crossplatform/emulators/msdos/pc64/pc64w$cleanVersion.zip"
    }
}
