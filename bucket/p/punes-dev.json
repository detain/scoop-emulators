{
    "version": "848-20251231-2ed5b1b",
    "description": "Qt-based Nintendo Entertainment System emulator and NSF/NSFe Music Player (Direct3D Version)",
    "homepage": "https://github.com/punesemu/puNES",
    "license": "GPL-2.0-only",
    "architecture": {
        "32bit": {
            "url": "https://nightly.link/punesemu/puNES/workflows/build/master/punes32.wip.d3d9.zip",
            "hash": "110b0e98f8d0bd52e563fc9578c41fc806925092e03347e5789f97e4758262ac"
        },
        "64bit": {
            "url": "https://nightly.link/punesemu/puNES/workflows/build/master/punes64.wip.d3d9.zip",
            "hash": "a4fd8fd2260cacdde5fc5a13b44085f78d28cba2ef54578542a77a526eb568b3"
        }
    },
    "pre_install": [
        "'input.cfg', 'puNES.cfg', 'recent.cfg' | ForEach-Object {",
        "    if (!(Test-Path \"$persist_dir\\$_\")) { New-Item \"$dir\\$_\" -ItemType File | Out-Null }",
        "}"
    ],
    "bin": [
        [
            "punes.exe",
            "punes-dev",
            "--portable"
        ]
    ],
    "shortcuts": [
        [
            "punes.exe",
            "puNES (Direct3D) (dev)",
            "--portable"
        ]
    ],
    "persist": [
        "bios",
        "cheat",
        "diff",
        "jsc",
        "pgs",
        "prb",
        "save",
        "screenshot",
        "shp",
        "tmp",
        "input.cfg",
        "puNES.cfg",
        "recent.cfg"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/punesemu/puNES/actions/workflows/build.yml/runs?branch=master&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<run>\\d+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})\\S* (?<commit>[\\da-f]{7})",
        "replace": "${run}-${year}${month}${day}-${commit}"
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://nightly.link/punesemu/puNES/workflows/build/master/punes32.wip.d3d9.zip"
            },
            "64bit": {
                "url": "https://nightly.link/punesemu/puNES/workflows/build/master/punes64.wip.d3d9.zip"
            }
        }
    }
}
