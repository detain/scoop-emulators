{
    "version": "20261113-g3038783",
    "description": "Open-source engine for Heroes of Might and Magic III (development version)",
    "homepage": "https://vcmi.eu/",
    "license": "GPL-2.0-or-later",
    "notes": [
        "VCMI requires the original Heroes of Might and Magic III data files.",
        "Run the VCMI Launcher and import them from a GOG offline installer or an existing installation.",
        "User data (game data, mods, saves, settings) is stored in $persist_dir\\data."
    ],
    "architecture": {
        "64bit": {
            "url": "https://download.vcmi.eu/branch/develop/windows-zip-x64/VCMI-branch-develop-3038783.zip",
            "hash": "4d9b36479617739e7274f9534ebd60213abc0173ddc0f977b5286243bcb1285e"
        },
        "32bit": {
            "url": "https://download.vcmi.eu/branch/develop/windows-zip-x86/VCMI-branch-develop-3038783.zip",
            "hash": "552f8b7b7b138f804f0675cff8bb034e2e973cf0d59eb4c39c272f081d082356"
        },
        "arm64": {
            "url": "https://download.vcmi.eu/branch/develop/windows-zip-arm64/VCMI-branch-develop-3038783.zip",
            "hash": "35a5d10d11c87e165cd75c43f82e2f2ee18383af89ba762e42dd2518859a528d"
        }
    },
    "pre_install": [
        "$dirsJson = @{ userDataPath = \"$dir\\data\" } | ConvertTo-Json",
        "[IO.File]::WriteAllText(\"$dir\\config\\dirs.json\", $dirsJson)"
    ],
    "bin": [
        [
            "VCMI_launcher.exe",
            "vcmi-dev"
        ],
        [
            "VCMI_client.exe",
            "vcmi-client-dev"
        ],
        [
            "VCMI_mapeditor.exe",
            "vcmi-mapeditor-dev"
        ]
    ],
    "shortcuts": [
        [
            "VCMI_launcher.exe",
            "VCMI (dev)"
        ],
        [
            "VCMI_mapeditor.exe",
            "VCMI Map Editor (dev)"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://builds.vcmi.download/branch/develop/metadata/",
        "script": [
            "$m = [regex]::Match($page, 'VCMI-branch-develop-([0-9a-f]{7})\\.json</a></td><td class=\"size\">\\s*\\d+</td><td class=\"date\">(\\d{4}-\\w{3}-\\d{2})')",
            "$date = [datetime]::ParseExact($m.Groups[2].Value, 'yyyy-MMM-dd', [cultureinfo]::InvariantCulture).ToString('yyyyMMdd')",
            "Write-Output \"$date-g$($m.Groups[1].Value)\""
        ],
        "regex": "(\\d{8}-g(?<commit>[0-9a-f]{7}))"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.vcmi.eu/branch/develop/windows-zip-x64/VCMI-branch-develop-$matchCommit.zip",
                "hash": {
                    "url": "https://builds.vcmi.download/branch/develop/metadata/VCMI-branch-develop-$matchCommit.json",
                    "jsonpath": "$.builds['windows-x64'].package.sha256"
                }
            },
            "32bit": {
                "url": "https://download.vcmi.eu/branch/develop/windows-zip-x86/VCMI-branch-develop-$matchCommit.zip",
                "hash": {
                    "url": "https://builds.vcmi.download/branch/develop/metadata/VCMI-branch-develop-$matchCommit.json",
                    "jsonpath": "$.builds['windows-x86'].package.sha256"
                }
            },
            "arm64": {
                "url": "https://download.vcmi.eu/branch/develop/windows-zip-arm64/VCMI-branch-develop-$matchCommit.zip",
                "hash": {
                    "url": "https://builds.vcmi.download/branch/develop/metadata/VCMI-branch-develop-$matchCommit.json",
                    "jsonpath": "$.builds['windows-arm64'].package.sha256"
                }
            }
        }
    }
}
