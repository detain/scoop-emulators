{
    "version": "490-20260923-4cb8d92",
    "description": "Multi-system emulator focused on accuracy and preservation (development version)",
    "homepage": "https://github.com/ares-emulator/ares",
    "license": "ISC",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/ares-emulator/ares/workflows/push/master/ares-windows-x64.zip",
            "hash": "89b2f79837c11e914bece01f04bd4938945cfe1fe4ab533019eab6ecbbf9bd3a"
        }
    },
    "pre_install": "Expand-7zipArchive \"$dir\\ares-windows-x64.tar.xz\" \"$dir\" -Removal",
    "bin": "ares.exe",
    "shortcuts": [
        [
            "ares.exe",
            "ares (dev)"
        ]
    ],
    "post_install": [
        "if (!(Test-Path \"$persist_dir\\settings.bml.bak\")) {",
        "   New-Item -ItemType File \"$dir\\settings.bml\" | Out-Null",
        "   Set-Content \"$dir\\settings.bml\" 'Paths'",
        "   Add-Content \"$dir\\settings.bml\" \"  Home`:` $persist_dir\\Systems\\\" ",
        "   'Saves', 'Screenshots', 'Debugging' | ForEach-Object {",
        "   Add-Content \"$dir\\settings.bml\" \"  $_`:` $persist_dir\\$_\\\" }",
        "} else {",
        "   Copy-Item \"$persist_dir\\settings.bml.bak\" \"$dir\\settings.bml\" -Force",
        "}"
    ],
    "uninstaller": {
        "script": [
            "'settings.bml' | ForEach-Object {",
            "    Copy-Item \"$dir\\$_\" \"$persist_dir\\$_.bak\" -Force",
            "}"
        ]
    },
    "persist": [
        "Systems",
        "Saves",
        "Screenshots",
        "Debugging"
    ],
    "checkver": {
        "github": "https://api.github.com/repos/ares-emulator/ares/actions/workflows/push.yml/runs?branch=master&status=success",
        "script": [
            "$sha = json_path $page $.workflow_runs[0].head_sha",
            "$runId = json_path $page $.workflow_runs[0].run_number",
            "$date = json_path $page $.workflow_runs[0].created_at",
            "Write-Output \"$runId $date $sha\""
        ],
        "regex": "^(?<version>[^ ]+) (?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})[^ ]+ (?<hash>.{7})(?<rest>.*)$",
        "replace": "${version}-${year}${month}${day}-${hash}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/ares-emulator/ares/workflows/push/master/ares-windows-x64.zip"
            }
        }
    }
}
